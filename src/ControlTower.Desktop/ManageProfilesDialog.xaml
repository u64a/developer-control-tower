<Window x:Class="ControlTower.Desktop.ManageProfilesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ControlTower.Desktop.Controls"
        Title="Manage workspace profiles"
        Icon="Assets/app-icon.png"
        Height="650"
        Width="880"
        MinHeight="560"
        MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource BaseWindowStyle}"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <DockPanel>
        <controls:WindowTitleBar DockPanel.Dock="Top" />
        <Border DockPanel.Dock="Top" Height="3" Background="{StaticResource BrandStripBrush}" />

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Workspace profiles" Style="{StaticResource SubtitleTextStyle}" />
                <TextBlock Margin="0,4,0,0"
                           Text="Profiles are named project memberships. Their names do not change behavior."
                           Style="{StaticResource CaptionTextStyle}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border x:Name="ValidationPanel"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    Margin="0,0,0,12"
                    Padding="10,8"
                    CornerRadius="8"
                    Background="{DynamicResource CautionSubtleBrush}"
                    BorderBrush="{DynamicResource CautionBrush}"
                    BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left"
                               FontFamily="{StaticResource SymbolIconFont}"
                               Text="&#xE7BA;"
                               Margin="0,0,8,0"
                               Foreground="{DynamicResource CautionBrush}" />
                    <TextBlock x:Name="ValidationText"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                </DockPanel>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Click="AddProfileClick"
                                    AutomationProperties.Name="Add workspace profile"
                                    MinWidth="92">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource SymbolIconFont}"
                                               Text="&#xE710;"
                                               Margin="0,0,6,0" />
                                    <AccessText Text="_Add" />
                                </StackPanel>
                            </Button>
                            <Button Click="DeleteProfileClick"
                                    Style="{StaticResource DestructiveButtonStyle}"
                                    AutomationProperties.Name="Delete selected workspace profile"
                                    MinWidth="92">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource SymbolIconFont}"
                                               Text="&#xE74D;"
                                               Margin="0,0,6,0" />
                                    <AccessText Text="_Delete" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <TextBlock DockPanel.Dock="Top"
                                   Text="PROFILES"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Margin="2,0,0,8" />
                        <ListBox x:Name="ProfileList"
                                 DisplayMemberPath="Name"
                                 SelectionChanged="ProfileSelectionChanged"
                                 AutomationProperties.Name="Workspace profiles" />
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="PROFILE NAME"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <TextBox Grid.Row="1"
                                 x:Name="ProfileNameBox"
                                 Margin="0,7,0,14"
                                 MinHeight="34"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding SelectedItem.Name, ElementName=ProfileList, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Selected profile name" />

                        <TextBlock Grid.Row="2"
                                   Text="INCLUDED PROJECTS"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Grid.Row="3"
                                   Margin="0,5,0,8"
                                   Text="Membership uses canonical portfolio project IDs. Unchecked projects stay available here."
                                   Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap" />

                        <ScrollViewer Grid.Row="4"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="MembershipList"
                                          AutomationProperties.Name="Projects included in selected profile">
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <CheckBox IsChecked="{Binding IsIncluded, Mode=OneWay}"
                                                      IsThreeState="True"
                                                      Click="MembershipGroupClick"
                                                      Padding="2,5"
                                                      FontWeight="SemiBold"
                                                      AutomationProperties.Name="{Binding Name, StringFormat='Include all projects in {0}'}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" />
                                                    <TextBlock Text="{Binding ProjectCount, StringFormat=' · {0}'}"
                                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                                </StackPanel>
                                            </CheckBox>
                                            <ItemsControl ItemsSource="{Binding Projects}"
                                                          Margin="16,0,0,0">
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsIncluded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  Padding="2,5"
                                                                  ToolTip="{Binding ProjectId}"
                                                                  HorizontalContentAlignment="Stretch"
                                                                  AutomationProperties.Name="{Binding DisplayName}">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding DisplayName}"
                                                                           FontFamily="{StaticResource AppFontFamilyDisplay}"
                                                                           FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding RepoLocation}"
                                                                           FontFamily="{StaticResource MonoFontFamily}"
                                                                           FontSize="10.5"
                                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Margin="0,1,0,0" />
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock Grid.Row="5"
                                   x:Name="StaleMembersText"
                                   Margin="0,8,0,0"
                                   Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="3" Margin="0,14,0,0">
                <TextBlock x:Name="DialogStatusText"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource CautionBrush}"
                           TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Width="92" Click="CancelClick" />
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Width="118"
                            Click="SaveClick">
                        <AccessText Text="_Save profiles" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
