<Window x:Class="ControlTower.Desktop.NewGroupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ControlTower.Desktop.Controls"
        Title="New group"
        Icon="Assets/app-icon.png"
        Height="280"
        Width="420"
        MinHeight="280"
        MinWidth="380"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource BaseWindowStyle}"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <DockPanel>
        <controls:WindowTitleBar DockPanel.Dock="Top" />
        <Border DockPanel.Dock="Top" Height="3" Background="{StaticResource BrandStripBrush}" />
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Group name" Style="{StaticResource SubtitleTextStyle}" />
            <TextBlock Grid.Row="1" Margin="0,4,0,10"
                       Text="e.g. Customer Projects, IPKits, Personnel"
                       FontFamily="{StaticResource MonoFontFamily}" FontSize="11"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBox x:Name="GroupNameBox" Grid.Row="2" Height="32" VerticalAlignment="Top" VerticalContentAlignment="Center" />
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Cancel" Width="90" Click="CancelClick" />
                <Button Style="{StaticResource PrimaryButtonStyle}" Width="120" Click="OkClick" Content="Create &amp; move" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
