<Window x:Class="ControlTower.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ControlTower.Desktop.Controls"
        Title="Developer Control Tower"
        Icon="Assets/app-icon.png"
        Height="760"
        Width="1420"
        MinHeight="620"
        MinWidth="1120"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource BaseWindowStyle}"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <CollectionViewSource x:Key="GroupedProjects" Source="{Binding Projects}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Project.Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>
    <DockPanel>
    <controls:WindowTitleBar DockPanel.Dock="Top" ShowLauncherChip="True" />
    <Border DockPanel.Dock="Top" Height="3" Background="{StaticResource BrandStripBrush}" />
    <Grid Margin="16,14,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="34" Height="34" CornerRadius="9" Margin="0,0,11,0"
                        Background="{DynamicResource PanelSubtleBrush}"
                        BorderBrush="{DynamicResource SecondaryBorderBrush}" BorderThickness="1">
                    <TextBlock FontFamily="{StaticResource SymbolIconFont}" Text="&#xEC05;"
                               FontSize="17" Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="DEVELOPER CONTROL TOWER" Style="{StaticResource BrandTitleStyle}" />
                    <TextBlock Text="PORTFOLIO · REPO TRUTH · LAUNCH CONTROL"
                               Style="{StaticResource MonoLabelStyle}" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                        TextElement.FontSize="12.5">
                <Button x:Name="ProfileButton"
                        Click="ProfileButtonClick"
                        Padding="10,7"
                        AutomationProperties.Name="Active workspace profile">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="ProfileContextMenu" />
                    </Button.ContextMenu>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource SymbolIconFont}"
                                   Text="&#xE77B;"
                                   Margin="0,0,7,0" />
                        <AccessText Text="_Workspace" />
                        <TextBlock Text=" · " Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock x:Name="ActiveProfileNameText"
                                   Text="All projects"
                                   MaxWidth="140"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ProfileWarningGlyph"
                                   FontFamily="{StaticResource SymbolIconFont}"
                                   Text="&#xE7BA;"
                                   Foreground="{DynamicResource CautionBrush}"
                                   Visibility="Collapsed"
                                   Margin="7,0,0,0" />
                        <TextBlock FontFamily="{StaticResource SymbolIconFont}"
                                   Text="&#xE70D;"
                                   FontSize="10"
                                   Margin="7,1,0,0" />
                    </StackPanel>
                </Button>
                <Button Click="LibraryClick" Padding="11,7">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource SymbolIconFont}" Text="&#xE8F1;" Margin="0,0,8,0" />
                        <AccessText Text="_Library" />
                    </StackPanel>
                </Button>
                <Button Click="SettingsClick" Padding="11,7">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource SymbolIconFont}" Text="&#xE713;" Margin="0,0,8,0" />
                        <AccessText Text="_Settings" />
                    </StackPanel>
                </Button>
                <Button Click="ToggleThemeClick" Padding="11,7">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource SymbolIconFont}" Text="&#xE793;" Margin="0,0,8,0" />
                        <TextBlock x:Name="ThemeToggleText" Text="Light mode" />
                    </StackPanel>
                </Button>
                <Button Click="AddProjectClick" Padding="11,7">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource SymbolIconFont}" Text="&#xE710;" Margin="0,0,8,0" />
                        <AccessText Text="_Add Project" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RefreshAllCommand}" Padding="11,7"
                        ToolTip="Scan all local repos now (SSH stays on-demand).">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource SymbolIconFont}" Text="&#xE895;" Margin="0,0,8,0" />
                        <AccessText Text="_Scan all" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Command row: search (stretch) + state filter chips (right). -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource InsetCardBorderStyle}" Padding="11,8" Margin="0,0,12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontFamily="{StaticResource SymbolIconFont}" Text="&#xE721;"
                               FontSize="14" VerticalAlignment="Center" Margin="0,0,9,0"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBox Grid.Column="1" x:Name="ConsoleSearchBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                             ToolTip="Search projects by name, branch, or path" />
                </Grid>
            </Border>
            <ItemsControl Grid.Column="1" ItemsSource="{Binding Tally}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource FilterChipStyle}"
                                Margin="6,0,0,0"
                                ToolTip="Filter the table by this state"
                                Command="{Binding DataContext.FilterByStateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource StatusLampStyle}" Width="8" Height="8" Margin="0,0,6,0"
                                         Visibility="{Binding IsAll, Converter={StaticResource BoolToVisNegated}}" />
                                <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource MonoFontFamily}" FontSize="11">
                                    <Run Text="{Binding Label}" />
                                    <Run Text=" " />
                                    <Run Text="{Binding Count}" FontWeight="SemiBold" />
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="12">
                <DockPanel LastChildFill="True">
                    <Grid DockPanel.Dock="Top" Margin="2,6,12,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="118" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="104" />
                            <ColumnDefinition Width="92" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding AllVisibleSelected, Mode=TwoWay}"
                                  ToolTip="Select all shown projects"
                                  AutomationProperties.Name="Select all shown projects" />
                        <TextBlock Grid.Column="2" Text="PROJECT" Style="{StaticResource MonoLabelStyle}" />
                        <TextBlock Grid.Column="3" Text="STATE" Style="{StaticResource MonoLabelStyle}" />
                        <TextBlock Grid.Column="4" Text="BRANCH" Style="{StaticResource MonoLabelStyle}" />
                        <TextBlock Grid.Column="5" Text="TREE" Style="{StaticResource MonoLabelStyle}" />
                        <TextBlock Grid.Column="6" Text="SYNC" Style="{StaticResource MonoLabelStyle}" />
                    </Grid>

                    <Border DockPanel.Dock="Bottom"
                            Margin="0,8,0,0"
                            Padding="12,8"
                            Background="{DynamicResource AccentSubtleBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Text="{Binding SelectionSummary}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Command="{Binding RefreshSelectedManyCommand}"
                                        Margin="0,0,8,0" Padding="10,4"
                                        ToolTip="Re-scan the checked projects (local only).">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource SymbolIconFont}" Text="&#xE895;" Margin="0,0,6,0" />
                                        <TextBlock Text="Refresh selected" />
                                    </StackPanel>
                                </Button>
                                <Button Click="BulkPushFromLibraryClick"
                                        Margin="0,0,8,0" Padding="10,4"
                                        ToolTip="Pick a library asset and push it to the checked projects.">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource SymbolIconFont}" Text="&#xE898;" Margin="0,0,6,0" />
                                        <TextBlock Text="Push from Library" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding OpenAllSelectedCommand}"
                                        Margin="0,0,8,0" Padding="10,4"
                                        ToolTip="Open each checked project in its workspace.">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource SymbolIconFont}" Text="&#xE8B7;" Margin="0,0,6,0" />
                                        <TextBlock Text="Open all" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ClearSelectionCommand}"
                                        Padding="10,4"
                                        ToolTip="Clear the selection.">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource SymbolIconFont}" Text="&#xE711;" Margin="0,0,6,0" />
                                        <TextBlock Text="Clear" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ListView ItemsSource="{Binding Source={StaticResource GroupedProjects}}"
                              SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                              MouseDoubleClick="ProjectRowDoubleClick"
                              BorderThickness="0"
                              Background="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GroupItem">
                                                    <Expander x:Name="grpExp" IsExpanded="True"
                                                              Expanded="GroupExpanderChanged"
                                                              Collapsed="GroupExpanderChanged"
                                                              Loaded="GroupExpanderLoaded"
                                                              Background="Transparent" BorderThickness="0">
                                                        <Expander.Header>
                                                            <StackPanel Orientation="Horizontal" Margin="2,4">
                                                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                                <TextBlock Text="{Binding ItemCount, StringFormat=' · {0}'}" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                            </StackPanel>
                                                        </Expander.Header>
                                                        <ItemsPresenter />
                                                    </Expander>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </ListView.GroupStyle>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="6,4" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="bd"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="3,0,0,0"
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                                  HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource ListHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource ListSelectedBrush}" />
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="rowGrid" ToolTip="{Binding Project.RiskSummary}">
                                    <Grid.ContextMenu>
                                        <ContextMenu Opened="RowMenuOpened" />
                                    </Grid.ContextMenu>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="118" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="92" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              ToolTip="Select for a bulk action"
                                              AutomationProperties.Name="{Binding Project.DisplayName}" />
                                    <Ellipse Grid.Column="1"
                                             Style="{StaticResource StatusLampStyle}"
                                             VerticalAlignment="Center"
                                             AutomationProperties.Name="{Binding Project.RepoState, Converter={StaticResource RepoStateToWord}}" />
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Project.DisplayName}"
                                                   FontFamily="{StaticResource AppFontFamilyDisplay}"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Project.RepoLocation}"
                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,1,0,0" />
                                    </StackPanel>
                                    <ContentControl Grid.Column="3"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Left"
                                                    Content="{Binding Project}"
                                                    ContentTemplate="{StaticResource StatePillTemplate}" />
                                    <TextBlock Grid.Column="4" Text="{Binding Project.Branch}" VerticalAlignment="Center" FontFamily="{StaticResource MonoFontFamily}" FontSize="11.5" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Grid.Column="5" Text="{Binding Project.WorkingTreeStatus}" VerticalAlignment="Center" FontFamily="{StaticResource MonoFontFamily}" FontSize="11.5" TextTrimming="CharacterEllipsis" Foreground="{Binding Project.WorkingTreeStatus, Converter={StaticResource TreeToBrush}}" />
                                    <TextBlock Grid.Column="6" Text="{Binding Project.SyncCompact}" VerticalAlignment="Center" FontFamily="{StaticResource MonoFontFamily}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{Binding Project, Converter={StaticResource SyncToBrush}}" />

                                    <StackPanel x:Name="rowActions" Grid.Column="2" Grid.ColumnSpan="5"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Stretch"
                                                Background="{DynamicResource ListHoverBrush}"
                                                Opacity="0">
                                        <Button Style="{StaticResource RowActionButtonStyle}" ToolTip="Open Code"
                                                Command="{Binding DataContext.OpenCodeForCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding Project}">
                                            <TextBlock FontFamily="{StaticResource SymbolIconFont}" Text="&#xE8B7;" />
                                        </Button>
                                        <Button Style="{StaticResource RowActionButtonStyle}" ToolTip="Open Remote (SSH)"
                                                Command="{Binding DataContext.OpenRemoteForCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding Project}">
                                            <TextBlock FontFamily="{StaticResource SymbolIconFont}" Text="&#xE7F5;" />
                                        </Button>
                                        <Button Style="{StaticResource RowActionButtonStyle}" ToolTip="Open GitHub"
                                                Command="{Binding DataContext.OpenGitHubForCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding Project}">
                                            <TextBlock FontFamily="{StaticResource SymbolIconFont}" Text="&#xE774;" />
                                        </Button>
                                        <Button Style="{StaticResource RowActionButtonStyle}" ToolTip="Open ADO"
                                                Command="{Binding DataContext.OpenAdoForCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding Project}">
                                            <TextBlock FontFamily="{StaticResource SymbolIconFont}" Text="&#xE70F;" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="rowGrid" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="rowActions" Property="Opacity" Value="1" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                <Border Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="CURRENT PROJECT" Style="{StaticResource MonoLabelStyle}" />
                        <TextBlock Text="{Binding SelectedProject.DisplayName}" Margin="0,6,0,4" Style="{StaticResource HeroTitleTextStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectedProject.Summary}" Margin="0,2,0,0" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                        <WrapPanel Margin="0,11,0,-6">
                            <ContentControl Content="{Binding SelectedProject}" ContentTemplate="{StaticResource StatePillTemplate}" Margin="0,0,6,6" VerticalAlignment="Center" />
                            <Border Style="{StaticResource MetaChipStyle}" Visibility="{Binding SelectedProject.WorkspaceMode, Converter={StaticResource StringToVis}}">
                                <TextBlock Text="{Binding SelectedProject.WorkspaceMode}" FontFamily="{StaticResource MonoFontFamily}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" />
                            </Border>
                            <Border Style="{StaticResource MetaChipStyle}" Visibility="{Binding SelectedProject.LifecycleState, Converter={StaticResource StringToVis}}">
                                <TextBlock Text="{Binding SelectedProject.LifecycleState}" FontFamily="{StaticResource MonoFontFamily}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" />
                            </Border>
                            <Border Style="{StaticResource MetaChipStyle}" Visibility="{Binding SelectedProject.PlanningAuthority, Converter={StaticResource StringToVis}}">
                                <TextBlock Text="{Binding SelectedProject.PlanningAuthority}" FontFamily="{StaticResource MonoFontFamily}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" />
                            </Border>
                        </WrapPanel>
                        <Grid Margin="0,12,0,0"
                              Visibility="{Binding SelectedProject.PrimaryRepoUrl, Converter={StaticResource StringToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding SelectedProject.PrimaryRepoUrl}"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding SelectedProject.PrimaryRepoUrl}" />
                            <Button Grid.Column="1"
                                    Style="{StaticResource RowActionButtonStyle}"
                                    Margin="6,0,0,0"
                                    Click="CopyRepoLinkClick"
                                    ToolTip="Copy repo link">
                                <TextBlock FontFamily="{StaticResource SymbolIconFont}" Text="&#xE8C8;" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="LAUNCH" Margin="0,0,0,10" Style="{StaticResource MonoLabelStyle}" />
                        <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding OpenCodeCommand}" IsEnabled="{Binding CanOpenCodeNormal}" ToolTipService.ShowOnDisabled="True" HorizontalContentAlignment="Left" Margin="0,0,0,8">
                            <Button.ToolTip>
                                <ToolTip>
                                    <TextBlock Text="{Binding OpenCodeDisabledTooltip}"
                                               TextWrapping="Wrap"
                                               MaxWidth="360" />
                                </ToolTip>
                            </Button.ToolTip>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ButtonIconStyle}" Text="&#xE8B7;" />
                                <AccessText Text="Open _Code" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RailButtonStyle}" Command="{Binding OpenCodeAdminCommand}" IsEnabled="{Binding CanOpenCode}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource SymbolIconFont}" Text="&#xE7EF;" Margin="0,0,8,0" />
                                <AccessText Text="Open Code RunAs _Admin" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RailButtonStyle}" Command="{Binding OpenRemoteCommand}" IsEnabled="{Binding CanOpenRemote}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ButtonIconStyle}" Text="&#xE7F5;" />
                                <AccessText Text="Open _Remote" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RailButtonStyle}"
                                Command="{Binding RefreshCommand}"
                                IsEnabled="{Binding CanManageProject}"
                                ToolTip="Re-scan this project's repo state.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ButtonIconStyle}" Text="&#xE72C;" />
                                <AccessText Text="Re_fresh project" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="CURRENT FOCUS" Margin="0,0,0,10" Style="{StaticResource MonoLabelStyle}" />
                        <TextBlock Text="Status" Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock Text="{Binding StatusMessage}" Margin="0,4,0,10" TextWrapping="Wrap" />
                        <TextBlock Text="Risk signal" Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock Text="{Binding SelectedProject.RiskSummary}" Margin="0,4,0,10" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="Activity" Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock Text="{Binding SelectedProject.ActivitySummary}" Margin="0,4,0,0" TextWrapping="Wrap" />

                        <StackPanel Margin="0,10,0,0"
                                    Visibility="{Binding SelectedProject.WorkspaceMode, Converter={StaticResource StringToVis}}">
                            <TextBlock Text="Workspace" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Text="{Binding SelectedProject.WorkspaceMode}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Margin="0,10,0,0"
                                    Visibility="{Binding SelectedProject.LifecycleState, Converter={StaticResource StringToVis}}">
                            <TextBlock Text="Lifecycle" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Text="{Binding SelectedProject.LifecycleState}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Margin="0,10,0,0"
                                    Visibility="{Binding SelectedProject.PlanningAuthority, Converter={StaticResource StringToVis}}">
                            <TextBlock Text="Planning authority" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Text="{Binding SelectedProject.PlanningAuthority}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="MANAGE" Margin="0,0,0,10" Style="{StaticResource MonoLabelStyle}" />
                        <Button Style="{StaticResource RailButtonStyle}" Click="EditProjectClick" IsEnabled="{Binding CanManageProject}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ButtonIconStyle}" Text="&#xE70F;" />
                                <AccessText Text="_Edit Project" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RailButtonStyle}" Click="RelocateProjectClick" IsEnabled="{Binding CanManageProject}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ButtonIconStyle}" Text="&#xE8AB;" />
                                <AccessText Text="_Relocate Project…" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DestructiveButtonStyle}" Click="DeleteProjectClick" IsEnabled="{Binding CanManageProject}" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ButtonIconStyle}" Text="&#xE74D;" />
                                <AccessText Text="_Remove Project" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="3"
                Margin="0,14,0,0"
                Padding="12,9"
                Background="{DynamicResource StatusBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="10">
            <DockPanel>
                <TextBlock FontFamily="{StaticResource SymbolIconFont}"
                           Text="&#xE946;"
                           Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,9,0" />
                <TextBlock Text="{Binding AppVersion}"
                           DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource MonoFontFamily}"
                           FontSize="11"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="12,0,0,0" />
                <Button DockPanel.Dock="Right"
                        Command="{Binding ViewLogCommand}"
                        Margin="12,0,0,0"
                        Padding="8,2"
                        VerticalAlignment="Center"
                        ToolTip="Open today's log file (or the log folder if no log has been written yet).">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource SymbolIconFont}" Text="&#xE9F9;" Margin="0,0,6,0" />
                        <TextBlock Text="View log" />
                    </StackPanel>
                </Button>
                <ProgressBar DockPanel.Dock="Right"
                             IsIndeterminate="True"
                             Width="120"
                             Height="6"
                             Margin="12,0,0,0"
                             VerticalAlignment="Center"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PortfolioSummaryLine}"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="11.5"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusMessage}"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="11.5"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
    </DockPanel>
</Window>
