<Window x:Class="ControlTower.Desktop.SetArchivePathDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ControlTower.Desktop.Controls"
        Title="Archive path"
        Icon="Assets/app-icon.png"
        Height="300"
        Width="480"
        MinHeight="300"
        MinWidth="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource BaseWindowStyle}"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <DockPanel>
        <controls:WindowTitleBar DockPanel.Dock="Top" />
        <Border DockPanel.Dock="Top" Height="3" Background="{StaticResource BrandStripBrush}" />
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Archive storage root for this project" Style="{StaticResource SubtitleTextStyle}" />
            <TextBlock Grid.Row="1" Margin="0,4,0,10"
                       Text="Overrides the global archive.storage_root for just this project. Leave blank to use the default. Must resolve under LocalAppData, RoamingAppData, your user profile, or OneDrive."
                       TextWrapping="Wrap"
                       FontFamily="{StaticResource MonoFontFamily}" FontSize="11"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ArchivePathBox" Grid.Column="0" Height="32" VerticalAlignment="Top" VerticalContentAlignment="Center" />
                <Button Grid.Column="1" Content="Browse…" Width="90" Margin="8,0,0,0" Click="BrowseClick" />
            </Grid>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Cancel" Width="90" Click="CancelClick" />
                <Button Style="{StaticResource PrimaryButtonStyle}" Width="100" Click="OkClick" Content="Save" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
