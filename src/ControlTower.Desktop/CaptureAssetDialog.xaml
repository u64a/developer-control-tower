<Window x:Class="ControlTower.Desktop.CaptureAssetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ControlTower.Desktop.Controls"
        Title="Capture Asset"
        Icon="Assets/app-icon.png"
        Height="540"
        Width="640"
        MinHeight="500"
        MinWidth="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource BaseWindowStyle}"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <DockPanel>
    <controls:WindowTitleBar DockPanel.Dock="Top" />
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Capture asset from project"
                       Style="{StaticResource SubtitleTextStyle}" />
            <TextBlock Text="Copy a folder from a local project into the library."
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Margin="0,2,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Source project" VerticalAlignment="Center" Margin="0,0,12,8" />
                <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ProjectComboBox" Margin="0,0,0,8"
                          SelectionChanged="ProjectComboBox_SelectionChanged" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Source folder" VerticalAlignment="Center" Margin="0,0,12,8" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="SourceFolderTextBox" Margin="0,0,0,8" />
                <Button Grid.Row="1" Grid.Column="2" Content="Browse..." Margin="8,0,0,8" Click="BrowseSourceClick" x:Name="BrowseButton" />

                <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                           x:Name="SourceHintText"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Asset type" VerticalAlignment="Center" Margin="0,0,12,8" />
                <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" x:Name="TypeComboBox" Margin="0,0,0,8" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Asset id" VerticalAlignment="Center" Margin="0,0,12,8" />
                <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" x:Name="AssetIdTextBox" Margin="0,0,0,8" />

                <TextBlock Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2"
                           x:Name="AssetIdHintText"
                           Text="The asset id becomes the folder name and the registry key. Use letters, digits, '.', '_' or '-'."
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="12"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" x:Name="StatusText"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource SecondaryTextBrush}" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource RailButtonStyle}" Click="CancelClick" Width="100">
                <TextBlock Text="Cancel" />
            </Button>
            <Button Style="{StaticResource PrimaryButtonStyle}" Click="CaptureClick" Margin="8,0,0,0" Width="120" x:Name="CaptureButton">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource SymbolIconFont}" Text="&#xE898;" Margin="0,0,8,0" />
                    <TextBlock Text="Capture" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
    </DockPanel>
</Window>
