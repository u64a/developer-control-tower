<Window x:Class="ControlTower.Desktop.UninstallDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ControlTower.Desktop.Controls"
        Title="Uninstall Developer Control Tower"
        Icon="Assets/app-icon.png"
        Height="620"
        Width="640"
        MinWidth="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource BaseWindowStyle}"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <DockPanel>
        <controls:WindowTitleBar DockPanel.Dock="Top" />
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="Uninstall from this device"
                           Style="{StaticResource SubtitleTextStyle}" />
                <TextBlock Text="Choose what should remain after the app is removed. Credential Manager entries are always preserved because other tools may use them."
                           Margin="0,4,0,0"
                           Style="{StaticResource CaptionTextStyle}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Row="1"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="16">
                <StackPanel>
                    <RadioButton x:Name="KeepDataRadio"
                                 GroupName="UninstallMode"
                                 IsChecked="True"
                                 Checked="ModeChanged">
                        <StackPanel Margin="6,0,0,10">
                            <TextBlock Text="Remove the app only"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Recommended. Keeps the portable portfolio, profiles, settings, project metadata, and asset library. Machine-local logs and preferences are removed."
                                       Style="{StaticResource CaptionTextStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="RemoveConfigRadio"
                                 GroupName="UninstallMode"
                                 Checked="ModeChanged">
                        <StackPanel Margin="6,0,0,10">
                            <TextBlock Text="Remove app and portable configuration; keep the library"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Removes the portfolio, profiles, settings, and central project metadata. The reusable asset library remains."
                                       Style="{StaticResource CaptionTextStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="RemoveAllRadio"
                                 GroupName="UninstallMode"
                                 Checked="ModeChanged">
                        <StackPanel Margin="6,0,0,10">
                            <TextBlock Text="Remove app and all portable data"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Removes the entire app-managed configuration folder, including the default asset library. A library configured outside that folder is preserved."
                                       Style="{StaticResource CaptionTextStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </RadioButton>

                    <Border x:Name="SharedDataWarning"
                            Style="{StaticResource CardBorderStyle}"
                            Padding="12,10"
                            Margin="0,4,0,10"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="This changes shared portable data"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource WarningBrush}" />
                            <TextBlock Text="Deleting portable configuration affects every device using this folder and cannot be undone by reinstalling the app."
                                       Foreground="{DynamicResource WarningBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,8" />
                            <CheckBox x:Name="SharedDataAcknowledge"
                                      Content="I understand this affects other devices."
                                      Checked="AcknowledgementChanged"
                                      Unchecked="AcknowledgementChanged" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="LegacyInstallWarning"
                            Style="{StaticResource CardBorderStyle}"
                            Padding="12,10"
                            Margin="0,0,0,10"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Legacy installation remains available"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource WarningBrush}" />
                            <TextBlock Text="This flow removes the packaged app only. The previous source-built copy is retained as a rollback path and can be removed manually after you are satisfied with the packaged release."
                                       Foreground="{DynamicResource WarningBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,4" />
                            <TextBlock x:Name="LegacyInstallPathText"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Portable data location"
                               Style="{StaticResource CaptionTextStyle}"
                               Margin="0,4,0,2" />
                    <TextBlock x:Name="ConfigRootText"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="11"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Current library"
                               Style="{StaticResource CaptionTextStyle}"
                               Margin="0,8,0,2" />
                    <TextBlock x:Name="LibraryPathText"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="11"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <Button Content="Cancel"
                        Width="100"
                        Click="CancelClick" />
                <Button x:Name="UninstallButton"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="120"
                        IsDefault="True"
                        Click="UninstallClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource SymbolIconFont}"
                                   Text="&#xE74D;"
                                   Margin="0,0,8,0" />
                        <TextBlock Text="Uninstall" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
