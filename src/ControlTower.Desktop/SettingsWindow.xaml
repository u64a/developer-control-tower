<Window x:Class="ControlTower.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ControlTower.Desktop.Controls"
        Title="Settings"
        Icon="Assets/app-icon.png"
        Height="680"
        Width="640"
        MinHeight="520"
        MinWidth="560"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource BaseWindowStyle}"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <DockPanel>
    <controls:WindowTitleBar DockPanel.Dock="Top" />
    <Border DockPanel.Dock="Top" Height="3" Background="{StaticResource BrandStripBrush}" />
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Settings"
                       Style="{StaticResource SubtitleTextStyle}" />
            <TextBlock x:Name="SettingsSubtitleText"
                       Margin="0,4,0,0"
                       FontFamily="{StaticResource MonoFontFamily}"
                       FontSize="11"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,4,0">

                <!-- Appearance Section -->
                <TextBlock Text="APPEARANCE"
                           Style="{StaticResource SectionTitleStyle}"
                           Margin="0,0,0,8" />
                <TextBlock Text="Accent colour"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="0,0,0,6" />
                <ComboBox x:Name="AccentCombo"
                          Width="240"
                          HorizontalAlignment="Left"
                          SelectionChanged="AccentComboChanged">
                    <ComboBoxItem Content="Tower cyan (brand)" />
                    <ComboBoxItem Content="Windows accent (system)" />
                </ComboBox>
                <TextBlock Text="Applies immediately. Tower cyan is the app's brand accent; Windows accent follows your system colour."
                           Style="{StaticResource CaptionTextStyle}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,16" />

                <!-- Stores Section -->
                    <TextBlock Text="REPO STORES"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,0,0,8" />

                    <ListBox x:Name="StoreListBox"
                             Height="120"
                             FontFamily="{StaticResource MonoFontFamily}"
                             SelectionChanged="StoreListBox_SelectionChanged" />

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,16">
                        <Button Content="Add local store" Click="AddLocalStoreClick" />
                        <Button Content="Add SSH store" Click="AddSshStoreClick" />
                        <Button Style="{StaticResource DestructiveButtonStyle}" Content="Remove" Click="RemoveStoreClick" />
                    </StackPanel>

                    <!-- Store Detail Section -->
                    <Border x:Name="StoreDetailPanel"
                            Style="{StaticResource InsetCardBorderStyle}"
                            Visibility="Collapsed"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Store ID" VerticalAlignment="Center" Margin="0,0,12,8" />
                            <TextBox x:Name="StoreIdTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Root path" VerticalAlignment="Center" Margin="0,0,12,8" />
                            <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="StoreRootTextBox" Grid.Column="0" />
                                <Button x:Name="BrowseStoreRootButton"
                                        Grid.Column="1"
                                        Content="Browse..."
                                        Margin="8,0,0,0"
                                        Click="BrowseStoreRootClick" />
                            </Grid>

                            <!-- SSH-only fields -->
                            <TextBlock x:Name="HostLabel" Grid.Row="2" Grid.Column="0" Text="Host" VerticalAlignment="Center" Margin="0,0,12,8" Visibility="Collapsed" />
                            <TextBox x:Name="StoreHostTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Visibility="Collapsed" />

                            <TextBlock x:Name="UserLabel" Grid.Row="3" Grid.Column="0" Text="User" VerticalAlignment="Center" Margin="0,0,12,8" Visibility="Collapsed" />
                            <TextBox x:Name="StoreUserTextBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" Visibility="Collapsed" />

                            <TextBlock x:Name="PortLabel" Grid.Row="4" Grid.Column="0" Text="Port" VerticalAlignment="Center" Margin="0,0,12,8" Visibility="Collapsed" />
                            <TextBox x:Name="StorePortTextBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" Text="22" Visibility="Collapsed" />

                            <!-- Credential section (SSH only) -->
                            <StackPanel x:Name="CredentialPanel" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0" Visibility="Collapsed">
                                <TextBlock Text="SSH PASSWORD (stored in Windows Credential Manager)"
                                           Style="{StaticResource SectionTitleStyle}"
                                           Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="SshPasswordBox" Grid.Column="0" Padding="10,7" MinHeight="34" />
                                    <TextBox x:Name="SshPasswordRevealBox"
                                             Grid.Column="0"
                                             Padding="10,7"
                                             MinHeight="34"
                                             IsReadOnly="True"
                                             Focusable="False"
                                             Visibility="Collapsed" />
                                    <Button x:Name="RevealPasswordButton"
                                            Grid.Column="1"
                                            Width="34"
                                            MinHeight="34"
                                            Margin="4,0,0,0"
                                            Focusable="False"
                                            ToolTip="Press and hold to reveal the password."
                                            PreviewMouseLeftButtonDown="RevealPasswordButton_PreviewMouseLeftButtonDown"
                                            PreviewMouseLeftButtonUp="RevealPasswordButton_PreviewMouseLeftButtonUp"
                                            MouseLeave="RevealPasswordButton_MouseLeave">
                                        <TextBlock FontFamily="{StaticResource SymbolIconFont}" Text="&#xE7B3;" />
                                    </Button>
                                    <Button Grid.Column="2" Content="Save password" Click="SavePasswordClick" Margin="8,0,0,0" />
                                    <Button x:Name="TestConnectionButton" Grid.Column="3" Content="Test" Click="TestConnectionClick" Margin="0,0,0,0" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <ProgressBar x:Name="TestConnectionProgress"
                                                 IsIndeterminate="True"
                                                 Width="120"
                                                 Height="6"
                                                 VerticalAlignment="Center"
                                                 Visibility="Collapsed" />
                                    <TextBlock x:Name="CredentialStatusText"
                                               Margin="8,0,0,0"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Restore -->
                    <TextBlock Text="RESTORE PROJECTS"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,16,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                        <Button x:Name="RestoreFromGitButton"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="RestoreFromGitClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource SymbolIconFont}" Text="&#xE896;" Margin="0,0,8,0" />
                                <TextBlock Text="Restore from Git…" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ScanFoldersButton"
                                Margin="8,0,0,0"
                                Click="ScanFoldersClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource SymbolIconFont}" Text="&#xE721;" Margin="0,0,8,0" />
                                <TextBlock Text="Scan folders for repos…" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="RestoreUnavailableText"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Visibility="Collapsed"
                                   Text="Restore is unavailable in this session." />
                    </StackPanel>
                    <TextBlock Text="Re-clone local-store projects whose folders are missing or empty, or scan disk folders to discover already-cloned repos and add them to the portfolio."
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0" />

                    <!-- Library -->
                    <TextBlock Text="ASSET LIBRARY"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,16,0,4" />
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="LibraryPathTextBox" />
                        <Button Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Click="BrowseLibraryClick" />
                    </Grid>
                    <TextBlock Text="Leave empty to use the portable, user-writable library under the configuration root."
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="12"
                               Margin="0,2,0,0" />

                    <!-- Updates -->
                    <TextBlock Text="UPDATES"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,16,0,4" />
                    <TextBlock x:Name="UpdateModeText"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8" />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="UpdateBranchLabel" Grid.Row="0" Grid.Column="0" Text="Branch" VerticalAlignment="Center" Margin="0,0,12,6" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="UpdateBranchTextBox" Margin="0,0,0,6" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Auto-check on launch" VerticalAlignment="Center" Margin="0,0,12,6" />
                        <CheckBox Grid.Row="1" Grid.Column="1" x:Name="UpdateAutoCheckBox" VerticalAlignment="Center" Margin="0,0,0,6" />

                        <TextBlock x:Name="UpdateRepoRootLabel" Grid.Row="2" Grid.Column="0" Text="Repo root override" VerticalAlignment="Center" Margin="0,0,12,6" />
                        <Grid x:Name="UpdateRepoRootPanel" Grid.Row="2" Grid.Column="1" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="UpdateRepoRootTextBox" />
                            <Button Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Click="BrowseUpdateRepoRootClick" />
                        </Grid>
                    </Grid>
                    <TextBlock x:Name="UpdateRepoHint"
                               Text="Leave repo root empty to use the source-clone sentinel written by the developer installer."
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button x:Name="CheckForUpdatesButton"
                                Click="CheckForUpdatesNowClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x27F3;" Margin="0,0,8,0" />
                                <TextBlock Text="Check for updates now" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="UpdateStatusText"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Launcher -->
                    <TextBlock Text="LAUNCHER"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,16,0,4" />
                    <TextBlock Text="Press Ctrl+K anywhere in the app to open the launcher. Search a project, then Enter to open it in VS Code, Ctrl+Enter to expand into the full console, or Ctrl+L to open the asset library."
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />

                    <!-- Config Info -->
                    <TextBlock Text="CONFIG LOCATION"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,16,0,4" />
                    <TextBlock x:Name="ConfigLocationText"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="11"
                               TextWrapping="Wrap" />

                    <TextBlock Text="DIAGNOSTICS"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,16,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="LogFolderText"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <Button Content="Open log folder" Margin="12,0,0,0" Click="OpenLogFolderClick" />
                    </StackPanel>

                    <StackPanel x:Name="AppManagementPanel">
                        <TextBlock Text="APP MANAGEMENT"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Margin="0,16,0,4" />
                        <TextBlock Text="Windows Settings removes only the installed app and always preserves your portable data. Use this flow when you also want to remove data from this device or the portable configuration folder."
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8" />
                        <Button x:Name="UninstallAppButton"
                                Content="Uninstall this device..."
                                HorizontalAlignment="Left"
                                Click="UninstallAppClick" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Width="90" Click="CancelClick" />
            <Button Style="{StaticResource PrimaryButtonStyle}" Width="100" Click="SaveClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource SymbolIconFont}" Text="&#xE74E;" Margin="0,0,8,0" />
                    <TextBlock Text="Save" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
    </DockPanel>
</Window>
