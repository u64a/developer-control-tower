<UserControl x:Class="ControlTower.Desktop.Controls.WindowTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             Height="32"
             Background="Transparent">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- Title-bar chip: same 32px height as caption buttons but
             padded for an icon + label so it reads as an actionable chip
             rather than a square caption glyph. -->
        <Style x:Key="TitleBarChipButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ListHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ListSelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- App icon -->
        <Image Grid.Column="0"
               x:Name="AppIconImage"
               Width="16" Height="16"
               Margin="12,0,0,0"
               VerticalAlignment="Center"
               Source="/Assets/app-icon.png" />

        <!-- Title text -->
        <TextBlock Grid.Column="1"
                   x:Name="TitleTextBlock"
                   Margin="10,0,0,0"
                   VerticalAlignment="Center"
                   FontFamily="{StaticResource AppFontFamilyCaption}"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryTextBrush}" />

        <!-- Drag region spacer (caption hit-test) -->
        <Border Grid.Column="2" Background="Transparent" />

        <!-- Launcher chip + Update chip share the pre-caption slot. -->
        <StackPanel Grid.Column="3" Orientation="Horizontal"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button x:Name="LauncherChipButton"
                    Style="{StaticResource TitleBarChipButtonStyle}"
                    Visibility="{Binding ShowLauncherChip, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                    Click="LauncherChipClick"
                    ToolTip="Open launcher (Ctrl+K)"
                    AutomationProperties.Name="Open launcher">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource SymbolIconFont}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Launcher" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="UpdateChipButton"
                    Style="{StaticResource TitleBarChipButtonStyle}"
                    Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed, TargetNullValue=Collapsed}"
                    ToolTip="{Binding UpdateChipTooltip}"
                    Click="UpdateChipClick"
                    AutomationProperties.Name="Update available">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x27F3;" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Update available" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Caption buttons -->
        <StackPanel Grid.Column="4" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button x:Name="MinButton"
                    Style="{StaticResource CaptionButtonStyle}"
                    Click="MinClick"
                    ToolTip="Minimize"
                    AutomationProperties.Name="Minimize">
                <TextBlock FontFamily="{StaticResource SymbolIconFont}" Text="&#xE921;" FontSize="10" />
            </Button>
            <Button x:Name="MaxButton"
                    Style="{StaticResource CaptionButtonStyle}"
                    Click="MaxClick"
                    ToolTip="Maximize"
                    AutomationProperties.Name="Maximize">
                <TextBlock x:Name="MaxGlyph" FontFamily="{StaticResource SymbolIconFont}" Text="&#xE922;" FontSize="10" />
            </Button>
            <Button x:Name="CloseButton"
                    Style="{StaticResource CloseCaptionButtonStyle}"
                    Click="CloseClick"
                    ToolTip="Close"
                    AutomationProperties.Name="Close">
                <TextBlock FontFamily="{StaticResource SymbolIconFont}" Text="&#xE8BB;" FontSize="10" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
