<Window x:Class="ControlTower.Desktop.PullAssetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ControlTower.Desktop.Controls"
        Title="Pull Asset Update"
        Icon="Assets/app-icon.png"
        Height="600"
        Width="780"
        MinHeight="480"
        MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource BaseWindowStyle}"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <DockPanel>
    <controls:WindowTitleBar DockPanel.Dock="Top" />
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Pull update from project"
                       Style="{StaticResource SubtitleTextStyle}" />
            <TextBlock x:Name="AssetSubtitleText"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Margin="0,2,0,0" />
            <TextBlock Text="Brings changes the project made into this library asset. Modified files default to off — tick to overwrite the library copy."
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Source project" VerticalAlignment="Center" Margin="0,0,12,8" />
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ProjectComboBox" Margin="0,0,0,8"
                          SelectionChanged="ProjectComboBox_SelectionChanged" />
                <Button Grid.Row="0" Grid.Column="2" Content="Preview" Margin="8,0,0,8" Click="PreviewClick" x:Name="PreviewButton" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Project asset path" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                           x:Name="ResolvedSourceText"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="CHANGE PREVIEW" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               x:Name="ChangeSummaryText"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="Select all" Click="SelectAllClick" Padding="10,4" />
                        <Button Content="Select none" Click="SelectNoneClick" Margin="6,0,0,0" Padding="10,4" />
                    </StackPanel>
                </Grid>

                <DataGrid Grid.Row="1"
                          x:Name="ChangesGrid"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          Background="Transparent"
                          BorderThickness="0"
                          RowBackground="Transparent"
                          AlternatingRowBackground="{DynamicResource PanelSubtleBrush}"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Pull" Binding="{Binding Apply, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                        <DataGridTextColumn Header="Kind" Binding="{Binding KindLabel}" Width="100" IsReadOnly="True" />
                        <DataGridTextColumn Header="Path" Binding="{Binding RelativePath}" Width="*" IsReadOnly="True" />
                        <DataGridTextColumn Header="Project" Binding="{Binding SourceSizeLabel}" Width="90" IsReadOnly="True"
                                            ElementStyle="{StaticResource TabularNumericCellStyle}" />
                        <DataGridTextColumn Header="Library" Binding="{Binding TargetSizeLabel}" Width="90" IsReadOnly="True"
                                            ElementStyle="{StaticResource TabularNumericCellStyle}" />
                    </DataGrid.Columns>
                </DataGrid>
                <controls:EmptyStatePresenter Grid.Row="1"
                                              x:Name="EmptyPreview"
                                              Glyph="&#xE9D5;"
                                              Heading="Nothing previewed yet"
                                              Hint="Pick a source project and click Preview to see what would change." />
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" x:Name="StatusText"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource SecondaryTextBrush}" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource RailButtonStyle}" Click="CancelClick" Width="100">
                <TextBlock Text="Cancel" />
            </Button>
            <Button Style="{StaticResource PrimaryButtonStyle}" Click="ApplyClick" Margin="8,0,0,0" Width="160" x:Name="ApplyButton" IsEnabled="False">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource SymbolIconFont}" Text="&#xE896;" Margin="0,0,8,0" />
                    <TextBlock Text="Pull into library" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
    </DockPanel>
</Window>
