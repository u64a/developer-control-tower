<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ControlTower.Desktop">

    <!-- ============================================================
         Status-lamp visual system (UI refresh, 2026-06).
         Lamp colour + pill background are data-driven via DataTriggers on
         RepoState and use DynamicResource brushes so they stay correct on a
         live light/dark toggle. The pill word + glyph differentiate state by
         text/shape, so we never rely on hue alone (resolves Behind-vs-accent
         and Attention-vs-destructive colour collisions).
         Expected DataContext for these styles: a ProjectOverview (exposes RepoState).
         ============================================================ -->

    <local:RepoStateToWordConverter x:Key="RepoStateToWord" />
    <local:RepoStateToGlyphConverter x:Key="RepoStateToGlyph" />
    <local:BooleanToVisibilityNegatedConverter x:Key="BoolToVisNegated" />
    <local:StringToVisibilityConverter x:Key="StringToVis" />
    <local:SyncToBrushConverter x:Key="SyncToBrush" />
    <local:TreeStatusToBrushConverter x:Key="TreeToBrush" />

    <!-- Brand identity strip: cyan -> teal -> green gradient, used as a thin
         accent bar under the title bar of every primary window. -->
    <LinearGradientBrush x:Key="BrandStripBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#4CC2FF" Offset="0" />
        <GradientStop Color="#2BD9B0" Offset="0.55" />
        <GradientStop Color="#4EF0A0" Offset="1" />
    </LinearGradientBrush>

    <!-- Global tooltip style. The WPF default tooltip is a light system
         surface, but our content inherits the dark-theme light foreground,
         so unstyled tooltips render as an empty (white-on-white) box. This
         implicit style gives every tooltip a theme-aware dark/light surface
         with a contrasting foreground so the text is always legible. -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource PaneBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MaxWidth" Value="380" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small state-coloured dot. -->
    <Style x:Key="StatusLampStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="11" />
        <Setter Property="Height" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Fill" Value="{DynamicResource NeutralBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding RepoState}" Value="Clean">
                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#7BD97B" BlurRadius="8" ShadowDepth="0" Opacity="0.8" />
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding RepoState}" Value="Ahead">
                <Setter Property="Fill" Value="{DynamicResource RepoAheadBrush}" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#45C7B8" BlurRadius="8" ShadowDepth="0" Opacity="0.8" />
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding RepoState}" Value="Behind">
                <Setter Property="Fill" Value="{DynamicResource InfoBrush}" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#5AA6FF" BlurRadius="8" ShadowDepth="0" Opacity="0.8" />
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding RepoState}" Value="Diverged">
                <Setter Property="Fill" Value="{DynamicResource CautionBrush}" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#FFB26B" BlurRadius="8" ShadowDepth="0" Opacity="0.8" />
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding RepoState}" Value="Uncommitted">
                <Setter Property="Fill" Value="{DynamicResource CautionBrush}" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#FFB26B" BlurRadius="8" ShadowDepth="0" Opacity="0.8" />
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding RepoState}" Value="Attention">
                <Setter Property="Fill" Value="{DynamicResource CriticalBrush}" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#FF6E6E" BlurRadius="9" ShadowDepth="0" Opacity="0.9" />
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding RepoState}" Value="Unavailable">
                <Setter Property="Fill" Value="{DynamicResource CriticalBrush}" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#FF6E6E" BlurRadius="8" ShadowDepth="0" Opacity="0.75" />
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding RepoState}" Value="HostedOnly">
                <Setter Property="Fill" Value="{DynamicResource NeutralBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Small bordered meta chip for the rail hero (workspace, lifecycle, authority). -->
    <Style x:Key="MetaChipStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="7,3" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Pill background: subtle state tint. -->
    <Style x:Key="StatePillStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusControl}" />
        <Setter Property="Padding" Value="7,2,8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="{DynamicResource NeutralSubtleBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding RepoState}" Value="Clean">
                <Setter Property="Background" Value="{DynamicResource SuccessSubtleBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding RepoState}" Value="Ahead">
                <Setter Property="Background" Value="{DynamicResource RepoAheadSubtleBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding RepoState}" Value="Behind">
                <Setter Property="Background" Value="{DynamicResource InfoSubtleBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding RepoState}" Value="Diverged">
                <Setter Property="Background" Value="{DynamicResource CautionSubtleBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding RepoState}" Value="Uncommitted">
                <Setter Property="Background" Value="{DynamicResource CautionSubtleBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding RepoState}" Value="Attention">
                <Setter Property="Background" Value="{DynamicResource CriticalSubtleBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding RepoState}" Value="Unavailable">
                <Setter Property="Background" Value="{DynamicResource CriticalSubtleBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Glyph inside the pill (state-by-shape). -->
    <Style x:Key="StatePillGlyphStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SymbolIconFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,5,0" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    </Style>

    <!-- Word inside the pill. -->
    <Style x:Key="StatePillTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamilyCaption}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    </Style>

    <!-- Reusable pill as a control template fed by a ProjectOverview DataContext. -->
    <DataTemplate x:Key="StatePillTemplate">
        <Border Style="{StaticResource StatePillStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource StatePillGlyphStyle}"
                           Text="{Binding RepoState, Converter={StaticResource RepoStateToGlyph}}" />
                <TextBlock Style="{StaticResource StatePillTextStyle}"
                           Text="{Binding RepoState, Converter={StaticResource RepoStateToWord}}" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- Compact icon button for inline per-row actions in the portfolio table.
         Disabled actions collapse to zero opacity so each row only shows the
         actions that apply (e.g. Open Remote on SSH rows, ADO on ADO rows). -->
    <Style x:Key="RowActionButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="3,0,0,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource SymbolIconFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.FontFamily="{StaticResource SymbolIconFont}"
                                          TextElement.FontSize="15" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Clickable filter chip (portfolio state filters; reuses the tally items). -->
    <Style x:Key="FilterChipStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource ListHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <!-- Theme-aware context menu: dark surface + readable foreground in both
         themes (default WPF menu is a light surface, which collides with our
         light foreground in dark mode = white-on-grey, unreadable). -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource PaneBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="Padding" Value="6,4" />
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="Margin" Value="0,3" />
    </Style>

</ResourceDictionary>
