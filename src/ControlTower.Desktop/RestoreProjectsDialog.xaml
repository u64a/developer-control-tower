<Window x:Class="ControlTower.Desktop.RestoreProjectsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ControlTower.Desktop.Controls"
        xmlns:local="clr-namespace:ControlTower.Desktop"
        Title="Restore Projects from Git"
        Icon="Assets/app-icon.png"
        Height="680"
        Width="1180"
        MinHeight="520"
        MinWidth="980"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource BaseWindowStyle}"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Window.Resources>
        <local:BrushKeyToBrushConverter x:Key="BrushKeyToBrushConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:BooleanToVisibilityNegatedConverter x:Key="BoolToVisNegated" />

        <Style x:Key="RowCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>

        <Style x:Key="ThinProgressStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="3" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource PanelSubtleBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <controls:WindowTitleBar DockPanel.Dock="Top" />
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="Restore projects from Git"
                           Style="{StaticResource SubtitleTextStyle}" />
                <TextBlock Text="Re-clone registered projects whose local folder is missing. Each origin is filled in from what the portfolio already knows; correct or paste one where needed."
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- Toolbar -->
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="{Binding SummaryText}"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <CheckBox VerticalAlignment="Center"
                              Margin="0,0,16,0"
                              Content="{Binding ShowAlreadyClonedLabel}"
                              IsChecked="{Binding ShowAlreadyCloned, Mode=TwoWay}"
                              Visibility="{Binding HasAlreadyCloned, Converter={StaticResource BoolToVis}}" />
                    <Button x:Name="RescanButton"
                            Width="100"
                            Click="RescanClick"
                            ToolTip="Check the portfolio against local folders again"
                            IsEnabled="{Binding CanScan}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource SymbolIconFont}" Text="&#xE72C;" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Rescan" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Busy / overall progress. Fixed height so the grid doesn't jump. -->
            <Grid Grid.Row="2" Height="3" Margin="0,0,0,6">
                <ProgressBar Style="{StaticResource ThinProgressStyle}"
                             Minimum="0" Maximum="100"
                             Value="{Binding OverallProgress, Mode=OneWay}"
                             IsIndeterminate="{Binding IsScanning}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <!-- Rows -->
            <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <controls:EmptyStatePresenter
                        Heading="{Binding EmptyHeading}"
                        Hint="{Binding EmptyHint}"
                        Visibility="{Binding HasNoRows, Converter={StaticResource BoolToVis}}" />

                    <DataGrid x:Name="RowsGrid"
                              ItemsSource="{Binding RowsView}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              CanUserReorderColumns="False"
                              CanUserSortColumns="False"
                              HeadersVisibility="Column"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              KeyboardNavigation.TabNavigation="Continue"
                              Visibility="{Binding HasNoRows, Converter={StaticResource BoolToVisNegated}}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="MinHeight" Value="48" />
                                <Setter Property="IsTabStop" Value="False" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                                        <Setter Property="Opacity" Value="0.6" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <!-- This grid is a form, not a selection list: cells
                             don't take focus or highlight, so Tab moves
                             straight between the checkboxes and URL boxes. -->
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Padding" Value="8,5" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <!-- Select -->
                            <DataGridTemplateColumn Width="40" MinWidth="40" CanUserResize="False">
                                <DataGridTemplateColumn.Header>
                                    <CheckBox IsChecked="{Binding DataContext.AreAllSelected, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"
                                              IsEnabled="{Binding DataContext.CanScan, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              ToolTip="Select or clear every project that can be restored" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanChangeSelection}"
                                                  AutomationProperties.Name="{Binding ProjectName}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Project + expected path -->
                            <DataGridTemplateColumn Header="Project" Width="*" MinWidth="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProjectName}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ExpectedPath}"
                                                       ToolTip="{Binding ExpectedPath}"
                                                       Style="{StaticResource RowCaptionStyle}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Status -->
                            <DataGridTemplateColumn Header="Status" Width="150" MinWidth="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8"
                                                         Margin="0,0,8,0"
                                                         VerticalAlignment="Center"
                                                         Fill="{Binding StateBrushKey, Converter={StaticResource BrushKeyToBrushConverter}}" />
                                                <TextBlock Text="{Binding StateLabel}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding PercentDisplay}"
                                                           Margin="6,0,0,0"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <ProgressBar Style="{StaticResource ThinProgressStyle}"
                                                         Margin="0,6,0,0"
                                                         Minimum="0" Maximum="100"
                                                         Value="{Binding PercentValue, Mode=OneWay}"
                                                         IsIndeterminate="{Binding IsPercentUnknown}"
                                                         Visibility="{Binding IsCloning, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Origin URL: editable for anything that can be restored -->
                            <DataGridTemplateColumn Header="Origin URL" Width="1.5*" MinWidth="300">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBox Text="{Binding OriginUrl, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                     IsEnabled="{Binding CanEditUrl}"
                                                     MinHeight="28"
                                                     Padding="8,4"
                                                     ToolTip="Clone URL — e.g. https://github.com/owner/repo.git or git@github.com:owner/repo.git"
                                                     AutomationProperties.Name="Origin URL"
                                                     Visibility="{Binding ShowUrlEditor, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding OriginUrl}"
                                                       ToolTip="{Binding OriginUrl}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding ShowUrlEditor, Converter={StaticResource BoolToVisNegated}}" />
                                            <TextBlock Text="{Binding UrlHint}"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding HasUrlHint, Converter={StaticResource BoolToVis}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource RowCaptionStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsUrlHintError}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource CriticalBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Detail / conflict action / error -->
                            <DataGridTemplateColumn Header="Detail" Width="280" MinWidth="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <ComboBox ItemsSource="{Binding ActionOptions}"
                                                      DisplayMemberPath="Label"
                                                      SelectedItem="{Binding SelectedActionOption, Mode=TwoWay}"
                                                      IsEnabled="{Binding CanEditUrl}"
                                                      Margin="0,0,0,4"
                                                      ToolTip="Quarantine moves the existing folder aside (nothing is deleted) before cloning"
                                                      Visibility="{Binding ShowActionPicker, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding Detail}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <TextBlock Text="{Binding ErrorMessage}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource CriticalBrush}"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding QuarantinePath}"
                                                       ToolTip="{Binding QuarantinePath}"
                                                       Style="{StaticResource RowCaptionStyle}"
                                                       Visibility="{Binding HasQuarantinePath, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Footer: status left, actions right -->
            <Grid Grid.Row="4" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"
                           Text="{Binding StatusText}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Close"
                            Width="90"
                            IsCancel="True"
                            Click="CloseClick"
                            IsEnabled="{Binding CanClose}" />
                    <Button x:Name="CancelButton"
                            Content="Cancel restore"
                            Width="120"
                            Margin="8,0,0,0"
                            Style="{StaticResource DestructiveButtonStyle}"
                            Click="CancelRestoreClick"
                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}" />
                    <Button x:Name="RestoreButton"
                            Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="170"
                            Margin="8,0,0,0"
                            Click="RestoreClick"
                            IsEnabled="{Binding CanRestore}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource SymbolIconFont}" Text="&#xE896;" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding RestoreButtonText}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
