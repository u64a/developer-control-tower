<Window x:Class="ControlTower.Desktop.ScanFoldersDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ControlTower.Desktop.Controls"
        xmlns:local="clr-namespace:ControlTower.Desktop"
        Title="Scan Folders for Repos"
        Icon="Assets/app-icon.png"
        Height="680"
        Width="1180"
        MinHeight="560"
        MinWidth="980"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource BaseWindowStyle}"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:NegateBooleanConverter x:Key="NegateBool" />
        <local:BooleanToVisibilityNegatedConverter x:Key="BoolToVisNegated" />
    </Window.Resources>

    <DockPanel>
        <controls:WindowTitleBar DockPanel.Dock="Top" />
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="Scan folders for repos"
                           Style="{StaticResource SubtitleTextStyle}" />
                <TextBlock Text="Pick up to 4 root folders. Developer Control Tower walks them at bounded depth (default 3 levels), surfaces every git repository it finds, and lets you bulk-register the ones you want to add to portfolio.yml."
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- Roots -->
            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="SCAN ROOTS"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Margin="0,0,0,6" />
                        <ListBox x:Name="RootsList"
                                 Height="86"
                                 ItemsSource="{Binding Roots}"
                                 DisplayMemberPath="Path" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="12,18,0,0" VerticalAlignment="Top">
                        <Button Content="Add folder..."
                                Width="120"
                                Click="AddRootClick"
                                IsEnabled="{Binding CanAddRoot}" />
                        <Button Content="Remove"
                                Width="120"
                                Margin="0,8,0,0"
                                Click="RemoveRootClick"
                                IsEnabled="{Binding CanRemoveRoot}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Scan toolbar -->
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="{Binding ProgressText}"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="ScanButton"
                            Content="Scan"
                            Width="100"
                            Click="ScanClick"
                            IsEnabled="{Binding CanScan}" />
                    <Button x:Name="CancelScanButton"
                            Content="Cancel scan"
                            Width="100"
                            Margin="8,0,0,0"
                            Style="{StaticResource DestructiveButtonStyle}"
                            Click="CancelScanClick"
                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}" />
                    <Button x:Name="SelectAllButton"
                            Content="Select all"
                            Margin="8,0,0,0"
                            Click="SelectAllClick"
                            IsEnabled="{Binding HasRows}" />
                    <Button x:Name="SelectNoneButton"
                            Content="Select none"
                            Margin="8,0,0,0"
                            Click="SelectNoneClick"
                            IsEnabled="{Binding HasRows}" />
                </StackPanel>
            </Grid>

            <!-- Results -->
            <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <controls:EmptyStatePresenter
                        Heading="No results yet"
                        Hint="Add at least one scan root and click Scan. Defaults are sane: depth 3, skips node_modules / bin / obj / .git, and ignores reparse points."
                        Visibility="{Binding HasNoRows, Converter={StaticResource BoolToVis}}" />

                    <DataGrid x:Name="RowsGrid"
                              ItemsSource="{Binding Rows}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              HeadersVisibility="Column"
                              IsReadOnly="False"
                              Visibility="{Binding HasNoRows, Converter={StaticResource BoolToVisNegated}}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDuplicate}" Value="True">
                                        <Setter Property="Opacity" Value="0.55" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <!-- Select -->
                            <DataGridTemplateColumn Width="40" MinWidth="40" CanUserSort="False">
                                <DataGridTemplateColumn.Header>
                                    <CheckBox x:Name="HeaderSelectAllCheckBox"
                                              Click="HeaderSelectAllClick"
                                              ToolTip="Select / clear all selectable rows" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center"
                                                  IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                  IsEnabled="{Binding IsSelectable}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Folder -->
                            <DataGridTemplateColumn Header="Folder" Width="200" MinWidth="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,4">
                                            <TextBlock Text="{Binding FolderName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SuggestedSlug}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Path -->
                            <DataGridTemplateColumn Header="Path" Width="*" MinWidth="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FolderPath}"
                                                   ToolTip="{Binding FolderPath}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Origin -->
                            <DataGridTemplateColumn Header="Origin" Width="220" MinWidth="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayOriginUrl}"
                                                   ToolTip="{Binding DisplayOriginUrl}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Branch -->
                            <DataGridTemplateColumn Header="Branch" Width="90" MinWidth="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Branch}" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- State -->
                            <DataGridTemplateColumn Header="State" Width="140" MinWidth="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StateLabel}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Detail -->
                            <DataGridTemplateColumn Header="Detail" Width="220" MinWidth="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,4">
                                            <TextBlock Text="{Binding Detail}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <TextBlock Text="{Binding OutcomeMessage}"
                                                       Margin="0,2,0,0"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Visibility="{Binding HasOutcome, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Status -->
            <TextBlock Grid.Row="4"
                       Margin="0,8,0,0"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Text="{Binding StatusText}" />

            <!-- Footer -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Close"
                        Width="90"
                        Click="CloseClick"
                        IsEnabled="{Binding CanClose}" />
                <Button x:Name="RegisterButton"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="180"
                        Margin="8,0,0,0"
                        Click="RegisterClick"
                        IsEnabled="{Binding CanRegister}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource SymbolIconFont}" Text="&#xE710;" Margin="0,0,8,0" />
                        <TextBlock Text="Register selected" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
