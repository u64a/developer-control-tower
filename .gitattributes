# Line endings — keep consistent across Windows/macOS/Linux contributors.
* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.sln text eol=crlf
*.csproj text eol=crlf
*.xaml text eol=crlf
*.cs text eol=crlf diff=csharp

# Binary assets — no line-ending munging
*.pptx binary
*.ico binary
*.png binary
*.jpg binary
*.dll binary
*.exe binary
